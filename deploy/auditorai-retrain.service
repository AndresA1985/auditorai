[Unit]
Description=AuditorAI nightly retraining from auditor-validated decisions
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sistemas201
Group=sistemas201
WorkingDirectory=/home/sistemas201/projects/auditorai
EnvironmentFile=-/home/sistemas201/projects/auditorai/.env
EnvironmentFile=-/etc/auditorai-retrain.env
ExecStart=/home/virtual/autitorai/bin/python scripts/retrain_audited_model.py
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
